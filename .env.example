# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_NAME="Secure LLM Gateway"
# API_KEY=sk-gateway-secret-token

# Semantic Caching
ENABLE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES=10000
CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Guardrails
ENABLE_INJECTION_GUARDRAIL=true
GUARDRAIL_BLOCK_INJECTIONS=true
INJECTION_CONFIDENCE_THRESHOLD=0.70
ENABLE_PII_SCRUBBING=true
PII_MASK_STYLE="tokenized"
ENABLE_OUTPUT_GUARDRAIL=true

# Resilience & Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_RPM=120
RATE_LIMIT_TPM=100000
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Providers
DEFAULT_PROVIDER="mock"
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
